<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aetheris" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aetheris_background</item>
        <item name="android:statusBarColor">@color/aetheris_background</item>
        <item name="android:navigationBarColor">@color/aetheris_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Aetheris.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aetheris_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/aetheris_splash_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Aetheris</item>
        <item name="windowSplashScreenAnimationDuration">1200</item>
    </style>
</resources>
