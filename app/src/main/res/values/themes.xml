<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aetheris" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aetheris_background</item>
        <item name="android:statusBarColor">@color/aetheris_background</item>
        <item name="android:navigationBarColor">@color/aetheris_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Aetheris.Splash" parent="Theme.Aetheris">
        <item name="android:windowSplashScreenBackground">@color/aetheris_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
</resources>
